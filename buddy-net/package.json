{
  "name": "buddy-net",
  "productName": "Buddy Net",
  "version": "0.1.0",
  "description": "Buddy Net - a time-travelling web browser: 90s, Internet Explorer, early Chrome, the experimental 2010s and the AI-filled 2020s",
  "author": "lattewirell-creator",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux deb --x64 --publish never"
  },
  "build": {
    "appId": "com.emil.buddynet",
    "productName": "Buddy Net",
    "directories": { "output": "release" },
    "files": ["*.js", "*.html", "*.css", "pages/**/*", "package.json"],
    "mac": { "identity": null, "category": "public.app-category.entertainment" },
    "linux": { "target": ["deb"], "category": "Network;WebBrowser", "executableName": "buddy-net" },
    "deb": { "packageName": "buddy-net", "maintainer": "lattewirell-creator <noreply@github.com>" }
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  },
  "license": "MIT"
}
